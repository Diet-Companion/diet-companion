{
  "openapi": "3.1.0",
  "info": {
    "title": "catalog-api",
    "version": "1.0.0",
    "description": "Catalog operations for the Owner. Draft for REQ-003. Draft security scheme is a placeholder until access control is decided (A-002). Nutrient values are assumed per 100 g (A-004)."
  },
  "security": [
    {
      "ownerKey": []
    }
  ],
  "paths": {
    "/products/label-photo": {
      "post": {
        "operationId": "addProductFromLabelPhoto",
        "summary": "Recognise a label photo and save the product when all required values are known. The photo is never stored.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Label photo, held in memory for this request only."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved with source label.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Error photo.unreadable. The photo cannot be processed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error product.duplicate_name_shop. A selectable product has the same name and shop (R-003). Nothing is saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error product.values_missing. One or more of name, shop, calories, protein, fat were not recognised. Nothing is saved. The body lists the missing fields and the recognised values so the client can call createProduct.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValuesMissing"
                }
              }
            }
          },
          "502": {
            "description": "Error recognition.unavailable. The recognition provider failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "post": {
        "operationId": "createProduct",
        "summary": "Save a product from supplied values. Enforces R-002 and R-003.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProduct"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "409": {
            "description": "Error product.duplicate_name_shop (R-003).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error product.values_missing (R-002).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValuesMissing"
                }
              }
            }
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Report whether the backend, its database and the label reader are reachable. Used by test and deployment checks.",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Error not.ready. At least one dependency is unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Owner-Key",
        "description": "Placeholder owner credential (A-002)."
      }
    },
    "parameters": {
      "RunId": {
        "name": "X-Run-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Correlation id echoed in logs and responses."
      }
    },
    "schemas": {
      "NewProduct": {
        "type": "object",
        "required": [
          "name",
          "shop",
          "calories",
          "protein",
          "fat",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shop": {
            "type": "string",
            "minLength": 1
          },
          "calories": {
            "type": "number",
            "minimum": 0,
            "x-unit": "kcal"
          },
          "protein": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g"
          },
          "fat": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g"
          },
          "brand": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "label",
              "lookup",
              "manual"
            ]
          }
        }
      },
      "Product": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NewProduct"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        }
      },
      "ValuesMissing": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "required": [
              "missing"
            ],
            "properties": {
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "name",
                    "shop",
                    "calories",
                    "protein",
                    "fat"
                  ]
                }
              },
              "recognised": {
                "type": "object",
                "description": "Values recognised so far; the client resends them with the supplied ones to createProduct.",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "shop": {
                    "type": "string"
                  },
                  "calories": {
                    "type": "number",
                    "x-unit": "kcal"
                  },
                  "protein": {
                    "type": "number",
                    "x-unit": "g"
                  },
                  "fat": {
                    "type": "number",
                    "x-unit": "g"
                  },
                  "brand": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      },
      "Readiness": {
        "type": "object",
        "required": [
          "ready"
        ],
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "database": {
            "type": "boolean"
          },
          "label_reader": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
