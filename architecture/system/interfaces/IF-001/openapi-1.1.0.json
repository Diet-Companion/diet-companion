{
  "openapi": "3.1.0",
  "info": {
    "title": "catalog-api",
    "version": "1.1.0",
    "description": "Catalog operations and Owner sign-in for the single Owner. Access control is password login with a server-side session per ADR-004 option d. Nutrient values are per 100 g."
  },
  "security": [
    {
      "ownerSession": []
    }
  ],
  "paths": {
    "/products/label-photo": {
      "post": {
        "operationId": "addProductFromLabelPhoto",
        "summary": "Recognise a label photo and save the product when all required values are known. The photo is never stored by the app.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Label photo, held in memory for this request only."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved with source label.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Error photo.unreadable. The photo cannot be processed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Error product.duplicate_name_shop. A selectable product has the same name and shop (R-003). Nothing is saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error product.values_missing. One or more of name, shop, calories, protein, fat were not recognised. Nothing is saved. The body lists the missing fields and the recognised values so the client can call createProduct.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValuesMissing"
                }
              }
            }
          },
          "502": {
            "description": "Error recognition.unavailable. The recognition provider failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "post": {
        "operationId": "createProduct",
        "summary": "Save a product from supplied values, including a product added by hand (source manual). Enforces R-002 and R-003.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProduct"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Error product.value_invalid. A supplied numeric value is negative. Nothing is saved. The body lists the offending fields. A value of 0 is not an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValueInvalid"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Error product.duplicate_name_shop (R-003).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error product.values_missing (R-002).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValuesMissing"
                }
              }
            }
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Report whether the backend, its database and the label reader are reachable. Used by test and deployment checks.",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Error not.ready. At least one dependency is unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "loginOwner",
        "summary": "Sign in with the Owner password. On success a session row is created and the owner_session cookie is set (ADR-004/C-007). Failed attempts are throttled (ADR-004/C-008).",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed in. Set-Cookie owner_session (HttpOnly, Secure, SameSite=Strict)."
          },
          "401": {
            "description": "Error auth.failed. The password is wrong. The response is the same whatever the cause.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Error auth.throttled. Too many failed attempts; try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "End the Owner session, delete its session row and clear the cookie.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "owner_session",
        "description": "Opaque session id in an HttpOnly Secure SameSite=Strict cookie, issued by loginOwner after a correct password and checked against a session row with an expiry (ADR-004)."
      }
    },
    "parameters": {
      "RunId": {
        "name": "X-Run-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Correlation id echoed in logs and responses."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Error auth.required. No valid Owner session.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "description": "The Owner password. Never logged or returned."
          }
        }
      },
      "NewProduct": {
        "type": "object",
        "required": [
          "name",
          "shop",
          "calories",
          "protein",
          "fat",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shop": {
            "type": "string",
            "minLength": 1
          },
          "calories": {
            "type": "number",
            "minimum": 0,
            "x-unit": "kcal",
            "description": "Per 100 g."
          },
          "protein": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Per 100 g."
          },
          "fat": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Per 100 g."
          },
          "brand": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "label",
              "lookup",
              "manual"
            ]
          },
          "carbohydrate": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Optional. Per 100 g. A 100 ml label value is sent as the same number (100 ml = 100 g)."
          },
          "sugars": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Optional. Per 100 g."
          },
          "fibre": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Optional. Per 100 g."
          },
          "salt": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Optional. Per 100 g. Sodium is computed from it (R-001)."
          },
          "portion_size": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Optional portion example size. Independent of portion_calories; either may be given alone. 0 is stored as empty."
          },
          "portion_calories": {
            "type": "number",
            "minimum": 0,
            "x-unit": "kcal",
            "description": "Optional. Calories of the portion example. Independent of portion_size; either may be given alone. 0 is stored as empty."
          },
          "piece_weight": {
            "type": "number",
            "minimum": 0,
            "x-unit": "g",
            "description": "Optional average weight of one piece. When present and above 0 the product is counted by the piece (R-003). 0 is stored as empty, so the product is not counted by the piece."
          }
        }
      },
      "Product": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NewProduct"
          },
          {
            "type": "object",
            "required": [
              "id",
              "sodium",
              "counted_by_piece"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "sodium": {
                "type": "number",
                "readOnly": true,
                "minimum": 0,
                "x-unit": "mg",
                "description": "Per 100 g. Computed on read as salt x 400; 0 when salt is empty (R-001). Never entered; a value sent in a request is ignored."
              },
              "counted_by_piece": {
                "type": "boolean",
                "readOnly": true,
                "description": "True when a piece weight is stored (R-003). Derived, never stored; a value sent in a request is ignored."
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        }
      },
      "ValueInvalid": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "required": [
              "invalid"
            ],
            "properties": {
              "invalid": {
                "type": "array",
                "description": "Fields whose supplied value is negative.",
                "items": {
                  "type": "string",
                  "enum": [
                    "calories",
                    "protein",
                    "fat",
                    "carbohydrate",
                    "sugars",
                    "fibre",
                    "salt",
                    "portion_size",
                    "portion_calories",
                    "piece_weight"
                  ]
                }
              }
            }
          }
        ]
      },
      "ValuesMissing": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "required": [
              "missing"
            ],
            "properties": {
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "name",
                    "shop",
                    "calories",
                    "protein",
                    "fat"
                  ]
                }
              },
              "recognised": {
                "type": "object",
                "description": "Values recognised so far, per 100 g; the client resends them with the supplied ones to createProduct.",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "shop": {
                    "type": "string"
                  },
                  "calories": {
                    "type": "number",
                    "x-unit": "kcal"
                  },
                  "protein": {
                    "type": "number",
                    "x-unit": "g"
                  },
                  "fat": {
                    "type": "number",
                    "x-unit": "g"
                  },
                  "brand": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      },
      "Readiness": {
        "type": "object",
        "required": [
          "ready"
        ],
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "database": {
            "type": "boolean"
          },
          "label_reader": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
